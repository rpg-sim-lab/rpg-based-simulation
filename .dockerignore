# Keep the build context small and the image free of local state (TCK-20261008-BACKEND-IMAGE-BUILDS-FROM-UV-LOCK).
.git
.venv*
node_modules
__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
.hypothesis
data/runs/
reports/
tmp/
scratch/
# Local secrets never belong in a build context (TCK-20261112-COMPOSE-STACK-HAS-NO-API-KEY): the repo-root .env and the gitignored docker/secrets/ files.
.env
docker/secrets/
