# Defaults for the frontend container (loaded first by compose.yaml's `env_file`; docker/secrets/frontend.env, if present, overrides it).
# Tracked on purpose: it holds no secret. An empty FRONTEND_API_KEY is the fail-closed default: nginx renders `proxy_set_header X-API-Key "";`, which sends
# no header, so the backend answers 401. The variable must be DEFINED (even empty): the base image's template step substitutes only variables that exist, and an
# undefined one would leave `${FRONTEND_API_KEY}` in the rendered file, which nginx refuses to start on.
FRONTEND_API_KEY=
